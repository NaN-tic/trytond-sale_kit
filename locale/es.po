msgctxt "field:product.product,explode_kit_in_sales:"
msgid "Explode in Sales"
msgstr "Expandir en las ventas"

msgctxt "field:sale.line,kit_child_lines:"
msgid "Lines in the kit"
msgstr "Líneas del kit"

msgctxt "field:sale.line,kit_depth:"
msgid "Depth"
msgstr "Profundidad"

msgctxt "field:sale.line,kit_parent_line:"
msgid "Parent Kit Line"
msgstr "Línea padre del kit"

msgctxt "help:product.product,kit_fixed_list_price:"
msgid ""
"Mark this field if the list price of the kit should be fixed. Do not mark it"
" if the price should be calculated from the sum of the prices of the "
"products in the pack."
msgstr ""
"Marque este campo si el precio del kit es fijo. Si no se marca, el precio se"
" calculará como la suma de los precios de los productos del kit."

msgctxt "help:sale.line,kit_child_lines:"
msgid "Subcomponents of the kit."
msgstr "Componentes del kit."

msgctxt "help:sale.line,kit_depth:"
msgid "Depth of the line if it is part of a kit."
msgstr "Profundidad de la línea si forma parte de un kit."

msgctxt "help:sale.line,kit_parent_line:"
msgid "The kit that contains this product."
msgstr "El kit que contiene este producto."

msgctxt "model:ir.message,text:salable_lines_required"
msgid ""
"The lines of a Kit with the flag \"Explode in Sales\" checked must to be "
"\"Salables\"."
msgstr ""
"Las líneas de un kit con la casilla \"Expandir en las ventas\" marcada deben "
"ser vendibles."

#, python-format
msgctxt "model:ir.message,text:salable_product_required_in_kit"
msgid ""
"The product \"%(product)s\" has the flag \"Explode in Sales\" checked but "
"not all the products of its lines are \"Salables\"."
msgstr ""
"El producto \"%(product)s\" tiene marcada la casilla \"Expandir en las ventas\", "
"pero no todos los productos de sus líneas son vendibles."

msgctxt "field:sale.sale,kit_component_shipments:"
msgid "Component Shipments"
msgstr "Albaranes de componentes"

msgctxt "field:stock.shipment.out,kit_component_shipments:"
msgid "Component Shipments"
msgstr "Albaranes de componentes"

msgctxt "field:stock.shipment.out,kit_parent_shipment:"
msgid "Kit Shipment"
msgstr "Albarán del kit"

msgctxt "field:stock.move,kit_parent_move:"
msgid "Kit Move"
msgstr "Movimiento del kit"

msgctxt "field:stock.move,kit_component_quantity:"
msgid "Component Quantity per Kit Unit"
msgstr "Cantidad del componente por unidad de kit"

msgctxt "field:stock.shipment.assign.partial,kit_summary:"
msgid "Kit Reservations"
msgstr "Reservas de kits"

#, python-format
msgctxt "model:ir.message,text:msg_component_shipment_control"
msgid "Manage component shipments through their kit shipment \"%(shipment)s\"."
msgstr ""
"Gestione los albaranes de componentes desde el albarán del kit \"%(shipment)s\"."

msgctxt "model:ir.message,text:msg_kit_move_change"
msgid ""
"Reset the kit shipment to draft before changing its product or unit, or to "
"waiting before changing its quantity."
msgstr ""
"Vuelva a poner el albarán del kit en borrador antes de cambiar su producto o "
"unidad, o en espera antes de cambiar su cantidad."

#, python-format
msgctxt "model:ir.message,text:msg_kit_reservation"
msgid ""
"%(kit)s: %(requested)s requested, %(reserved)s reserved as complete kits. "
"Ignore the unassigned quantities to send a partial shipment."
msgstr ""
"%(kit)s: cantidad solicitada: %(requested)s; cantidad reservada en kits "
"completos: %(reserved)s. Ignore las cantidades no reservadas para realizar "
"un envío parcial."

msgctxt "view:sale.sale:"
msgid "Kit Components"
msgstr "Componentes del kit"

msgctxt "view:stock.shipment.out:"
msgid "Kit Components"
msgstr "Componentes del kit"
